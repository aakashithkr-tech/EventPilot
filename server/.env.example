# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier, or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/eventpilot

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - your Vite frontend origin
CLIENT_URL=http://localhost:5174
# Optional comma-separated additional origins (useful after deployment)
# CLIENT_URLS=https://your-frontend.example,http://localhost:5174

# Connected-source security (required for Gmail token encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Gmail OAuth (Google Cloud OAuth Web application)
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback

# WhatsApp Business webhook (optional; official API channel, not personal/group scraping)
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# Optional server-to-server source sync secret for scheduled jobs
SOURCE_SYNC_SECRET=replace_with_a_long_random_secret

# Optional SMTP for sending team invitation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=EventPilot <no-reply@example.com>

# Gmail OAuth (Google Cloud OAuth client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are also accepted.
